// Pennydrop's database. Every moment is UTC (timestamptz); money is whole
// minor units (pence, cents, paise) in a bigint, with an ISO 4217 code beside it.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum SitePolicy {
  allowed
  api_only
  blocked
}

enum RobotsStatus {
  ok
  missing
  unreachable
}

enum BreakerState {
  closed
  open
  half_open
}

enum TargetStatus {
  active
  needs_attention
  blocked
  gone
  paused
}

enum FetchMode {
  http
  browser
}

enum CheckReason {
  scheduled
  manual
  preview
  confirm
  replay
}

enum CheckOutcome {
  ok
  unchanged
  suspicious
  price_not_found
  blocked
  rate_limited
  http_error
  gone
  robots_disallowed
  timeout
  network_error
  too_large
  not_html
  blocked_address
  skipped_breaker_open
}

enum RecipeSource {
  user
  auto
  healed
}

enum EventKind {
  layout_changed
  selector_healed
  needs_browser
  breaker_opened
  breaker_closed
  blocked
  robots_disallowed
  suspicious_price
  out_of_stock
  back_in_stock
  gone
}

/// A shop's hostname. Politeness, robots.txt and the breaker all work per site.
model Site {
  id               String        @id @default(uuid(7)) @db.Uuid
  host             String        @unique
  /// The registrable domain: "example.co.uk" for "shop.example.co.uk".
  registrable      String
  policy           SitePolicy    @default(allowed)
  /// The hosted demo only checks sites marked here.
  demoAllowed      Boolean       @default(false) @map("demo_allowed")
  robotsTxt        String?       @map("robots_txt")
  robotsStatus     RobotsStatus? @map("robots_status")
  robotsFetchedAt  DateTime?     @map("robots_fetched_at") @db.Timestamptz
  /// Seconds, from robots.txt.
  crawlDelay       Int?          @map("crawl_delay")
  /// At least this long between two requests to the site.
  minGapMs         Int           @default(10000) @map("min_gap_ms")
  maxInFlight      Int           @default(1) @map("max_in_flight")
  needsBrowser     Boolean       @default(false) @map("needs_browser")
  breakerState     BreakerState  @default(closed) @map("breaker_state")
  breakerOpenUntil DateTime?     @map("breaker_open_until") @db.Timestamptz
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  targets Target[]
  recipes Recipe[]
  events  Event[]

  @@map("sites")
}

/// A saved way to read a site's price. Healing retires one and writes another.
model Recipe {
  id         String       @id @default(uuid(7)) @db.Uuid
  siteId     String       @map("site_id") @db.Uuid
  selector   String
  attribute  String?
  pattern    String?
  source     RecipeSource
  activeFrom DateTime     @default(now()) @map("active_from") @db.Timestamptz
  retiredAt  DateTime?    @map("retired_at") @db.Timestamptz
  hits       Int          @default(0)
  misses     Int          @default(0)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, retiredAt])
  @@map("recipes")
}

/// A product page, shared by everyone who watches it and checked once for all of them.
model Target {
  id              String       @id @default(uuid(7)) @db.Uuid
  siteId          String       @map("site_id") @db.Uuid
  url             String
  canonicalUrl    String       @unique @map("canonical_url")
  status          TargetStatus @default(active)
  intervalSeconds Int          @default(21600) @map("interval_seconds")
  nextCheckAt     DateTime     @default(now()) @map("next_check_at") @db.Timestamptz
  lastCheckedAt   DateTime?    @map("last_checked_at") @db.Timestamptz
  lastSuccessAt   DateTime?    @map("last_success_at") @db.Timestamptz
  /// Failures in a row: drives retries, and "gone" or "blocked" after three.
  failureStreak   Int          @default(0) @map("failure_streak")
  etag            String?
  lastModified    String?      @map("last_modified")
  title           String?
  currentPrice    BigInt?      @map("current_price")
  currency        String?      @db.Char(3)
  inStock         Boolean?     @map("in_stock")
  /// A big jump waiting for a second check to confirm it.
  pendingPrice    BigInt?      @map("pending_price")
  pendingSince    DateTime?    @map("pending_since") @db.Timestamptz
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  checks      Check[]
  pricePoints PricePoint[]
  events      Event[]
  watches     Watch[]

  @@index([status, nextCheckAt])
  @@index([siteId])
  @@map("targets")
}

/// Every check, successful or not. Kept for 30 days, failures for 90.
model Check {
  id            String       @id @default(uuid(7)) @db.Uuid
  targetId      String       @map("target_id") @db.Uuid
  /// The queue job's id: a check retried after a crash is written once.
  jobId         String       @unique @map("job_id")
  reason        CheckReason
  mode          FetchMode?
  scheduledFor  DateTime     @map("scheduled_for") @db.Timestamptz
  startedAt     DateTime     @map("started_at") @db.Timestamptz
  finishedAt    DateTime     @map("finished_at") @db.Timestamptz
  outcome       CheckOutcome
  httpStatus    Int?         @map("http_status")
  /// Milliseconds per step, for the waterfall.
  timings       Json?
  strategy      String?
  confidence    Float?
  price         BigInt?
  wasPrice      BigInt?      @map("was_price")
  currency      String?      @db.Char(3)
  inStock       Boolean?     @map("in_stock")
  detail        String?
  /// Each strategy's reading, for "show me why".
  readings      Json?
  /// A failed browser check's screenshot, kept for 7 days.
  screenshotKey String?      @map("screenshot_key")

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId, startedAt(sort: Desc)])
  @@index([startedAt])
  @@map("checks")
}

/// Price history, stored only when something changes: an unchanged check moves lastSeenAt on.
model PricePoint {
  id           String   @id @default(uuid(7)) @db.Uuid
  targetId     String   @map("target_id") @db.Uuid
  firstSeenAt  DateTime @map("first_seen_at") @db.Timestamptz
  lastSeenAt   DateTime @map("last_seen_at") @db.Timestamptz
  price        BigInt?
  wasPrice     BigInt?  @map("was_price")
  currency     String   @db.Char(3)
  inStock      Boolean  @map("in_stock")
  firstCheckId String   @map("first_check_id") @db.Uuid
  /// Built by replaying the practice shop's past, not observed live.
  replayed     Boolean  @default(false)

  target Target  @relation(fields: [targetId], references: [id], onDelete: Cascade)
  alerts Alert[]

  @@index([targetId, firstSeenAt(sort: Desc)])
  @@map("price_points")
}

/// Things worth showing on a timeline: redesigns, heals, breakers, stock changes.
model Event {
  id       String    @id @default(uuid(7)) @db.Uuid
  siteId   String?   @map("site_id") @db.Uuid
  targetId String?   @map("target_id") @db.Uuid
  kind     EventKind
  details  Json      @default("{}")
  at       DateTime  @default(now()) @db.Timestamptz

  site   Site?   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  target Target? @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId, at])
  @@index([siteId, at])
  @@map("events")
}

// ---- Accounts, managed by Better Auth. Its ids are its own strings. ----

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  /// A demo visitor: signed in with one click, deleted with the demo.
  isAnonymous   Boolean  @default(false) @map("is_anonymous")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  /// A hash, never the password itself.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
  @@map("verifications")
}

// ---- Workspaces and what they watch. ----

enum MembershipRole {
  owner
  member
}

/// Every account gets its own workspace; teams come later.
model Workspace {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String
  /// For showing times and quiet hours.
  timezone   String    @default("Europe/London")
  isDemo     Boolean   @default(false) @map("is_demo")
  /// Demo workspaces are deleted after this.
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  maxWatches Int       @default(100) @map("max_watches")
  /// Quiet hours, as minutes after midnight in the workspace's zone. Alerts wait until they end.
  quietFrom  Int?      @map("quiet_from")
  quietUntil Int?      @map("quiet_until")
  /// One email a day, at digestAt, instead of alerts as they happen.
  digest     Boolean   @default(false)
  digestAt   Int       @default(480) @map("digest_at")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  memberships Membership[]
  watches     Watch[]
  groups      ProductGroup[]
  channels    Channel[]
  alerts      Alert[]

  @@map("workspaces")
}

model Membership {
  workspaceId String         @map("workspace_id") @db.Uuid
  userId      String         @map("user_id")
  role        MembershipRole @default(owner)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

/// The same item at several shops, compared side by side.
model ProductGroup {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  watches   Watch[]

  @@index([workspaceId])
  @@map("product_groups")
}

/// One workspace's interest in a product page: its own label, target and interval.
model Watch {
  id              String   @id @default(uuid(7)) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  targetId        String   @map("target_id") @db.Uuid
  groupId         String?  @map("group_id") @db.Uuid
  label           String?
  /// Minor units, in the product's currency.
  targetPrice     BigInt?  @map("target_price")
  intervalSeconds Int      @default(21600) @map("interval_seconds")
  /// The workspace's own listing, in a group of competitors.
  isMine          Boolean  @default(false) @map("is_mine")
  paused          Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  target    Target        @relation(fields: [targetId], references: [id], onDelete: Cascade)
  group     ProductGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  rules     AlertRule[]
  alerts    Alert[]

  @@unique([workspaceId, targetId])
  @@index([targetId])
  @@index([groupId])
  @@map("watches")
}

// ---- Alerts ----

enum AlertRuleKind {
  below_target
  drop_percent
  any_drop
  back_in_stock
  lowest_ever
  undercut
}

enum ChannelKind {
  email
  slack
  discord
  webhook
}

enum ChannelStatus {
  active
  broken
}

enum DeliveryStatus {
  pending
  batched
  sent
  failed
  skipped
}

/// When a watch should alert: one of each kind per watch.
model AlertRule {
  id          String        @id @default(uuid(7)) @db.Uuid
  watchId     String        @map("watch_id") @db.Uuid
  kind        AlertRuleKind
  /// "Drops by X%": the X.
  threshold   Int?
  /// Ready to fire. "Below target" and "undercut" disarm when they fire, until the reason has gone.
  armed       Boolean       @default(true)
  lastFiredAt DateTime?     @map("last_fired_at") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@unique([watchId, kind])
  @@map("alert_rules")
}

/// Where a workspace's alerts go. Its settings (an address, a secret) are sealed with AES-256-GCM.
model Channel {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  kind        ChannelKind
  name        String
  settings    String
  /// Enough of the address to recognise it: "hooks.slack.com/…/a1b2".
  hint        String
  status      ChannelStatus @default(active)
  /// Failed deliveries in a row: three, and it's marked broken.
  failures    Int           @default(0)
  lastError   String?       @map("last_error")
  lastSentAt  DateTime?     @map("last_sent_at") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries Delivery[]

  @@index([workspaceId])
  @@map("channels")
}

/// One per watch per new price point, listing every rule it met: one message for one change.
model Alert {
  id            String          @id @default(uuid(7)) @db.Uuid
  workspaceId   String          @map("workspace_id") @db.Uuid
  watchId       String          @map("watch_id") @db.Uuid
  pricePointId  String          @map("price_point_id") @db.Uuid
  kinds         AlertRuleKind[]
  price         BigInt?
  previousPrice BigInt?         @map("previous_price")
  currency      String?         @db.Char(3)
  /// Why it fired, in words, fixed at the time.
  reasons       String[]
  /// The price was a big jump, so a second check confirmed it before anyone was told.
  verified      Boolean         @default(false)
  firedAt       DateTime        @default(now()) @map("fired_at") @db.Timestamptz
  readAt        DateTime?       @map("read_at") @db.Timestamptz

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  watch      Watch      @relation(fields: [watchId], references: [id], onDelete: Cascade)
  pricePoint PricePoint @relation(fields: [pricePointId], references: [id], onDelete: Cascade)
  deliveries Delivery[]

  @@unique([watchId, pricePointId])
  @@index([workspaceId, firedAt(sort: Desc)])
  @@map("alerts")
}

/// One per alert per channel, sent and retried on its own.
model Delivery {
  id        String         @id @default(uuid(7)) @db.Uuid
  alertId   String         @map("alert_id") @db.Uuid
  channelId String         @map("channel_id") @db.Uuid
  status    DeliveryStatus @default(pending)
  attempts  Int            @default(0)
  lastError String?        @map("last_error")
  /// Held back (quiet hours, the digest, a busy hour) until then, to go in a summary.
  sendAfter DateTime?      @map("send_after") @db.Timestamptz
  heldFor   String?        @map("held_for")
  sentAt    DateTime?      @map("sent_at") @db.Timestamptz
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz

  alert   Alert   @relation(fields: [alertId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([alertId, channelId])
  @@index([status, sendAfter])
  @@index([channelId, createdAt])
  @@map("deliveries")
}
