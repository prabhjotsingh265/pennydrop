# Pennydrop in production: copy to .env.production (never committed) and fill in.
# Long random secrets come from: openssl rand -base64 32

# Where people open Pennydrop. Links in emails point here; cookies become Secure on https.
APP_URL=https://pennydrop.example.com
# The API's port, on this machine only: the tunnel or proxy in front points here.
API_PORT=8080
AUTH_SECRET=
# Seals alert channels' addresses. Changing it makes saved channels unreadable.
CHANNELS_KEY=
# Shared by the practice shop and the fetchers, for the demo's replayed history.
REPLAY_SECRET=
# Locks the practice shops' chaos controls; the API passes it for the demo.
SHOP_CHAOS_TOKEN=

# The database: the password twice, once for PostgreSQL and once in the address.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://pennydrop:REPLACE_WITH_THE_PASSWORD@postgres:5432/pennydrop
REDIS_URL=redis://redis:6379

# Email through Resend; the sender's domain must be verified there.
MAIL_FROM=Pennydrop <hello@pennydrop.example.com>
RESEND_API_KEY=

# The practice shops' public addresses, and where the API reaches their controls inside.
PRACTICE_SHOP_URL=https://{shop}.example.com
SHOP_INTERNAL_URL=http://shop:4000

# The tunnel or proxy in front reaches the API from this machine or a Docker network (the API's
# port is bound to this machine only): believe it about visitors' addresses.
TRUST_PROXY=loopback,uniquelocal

# Who sees the System page, and is emailed when something goes wrong.
ADMIN_EMAILS=
# Days of daily database backups kept on the server.
BACKUP_KEEP_DAYS=14

# To rehearse on your own machine, in a copy such as .env.rehearsal (make prod-up env=.env.rehearsal):
#   APP_URL=http://localhost:8080
#   LOCAL_SHOP_HOST=shop  and  PRACTICE_SHOP_URL=http://{shop}.localhost:4000
#   MAILPIT_URL=http://host.docker.internal:8026 (the development stack's Mailpit), no RESEND_API_KEY
# then make prod-demo days=7 and make prod-e2e, both with the same env=.
