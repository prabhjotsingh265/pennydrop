# Copy to .env (make setup does this). Never commit .env.

# Ports on your machine. Chosen so Halfpast can run at the same time.
FORWARD_WEB_PORT=3000
FORWARD_API_PORT=3001
FORWARD_SHOP_PORT=4000
FORWARD_DB_PORT=55433
FORWARD_MAILPIT_DASHBOARD_PORT=8026

# Inside Docker, services reach each other by name.
DATABASE_URL=postgresql://pennydrop:secret@postgres:5432/pennydrop
REDIS_URL=redis://redis:6379

# Accounts. Links in emails point at APP_URL. In production AUTH_SECRET must be
# set to a long random string (openssl rand -base64 32); in development a fixed
# one is used if it's missing.
APP_URL=http://localhost:3000
AUTH_SECRET=
MAIL_FROM=Pennydrop <hello@pennydrop.test>
# Mailpit catches every email locally: open http://localhost:8026 to read them.
MAILPIT_URL=http://mailpit:8025
# Production only: emails go out through Resend when this is set.
RESEND_API_KEY=

# Alert channels' addresses (Slack, Discord and webhook URLs) are stored
# encrypted with a key made from this. The API and the worker must share it, and
# changing it makes saved channels unreadable. In production set it to a long
# random string (openssl rand -base64 32); in development a fixed one is used.
CHANNELS_KEY=

# Who sees the System page (/admin): email addresses, separated by commas.
ADMIN_EMAILS=

# The practice shop shows the demo's replayed history only to requests signed
# with this, which the shop and the fetchers must share. In production set it to
# a long random string; in development a fixed one is used.
REPLAY_SECRET=

# Production, behind a proxy (such as a Cloudflare Tunnel): which proxies to
# believe about a visitor's address, for the limits on signing in and the like.
# "true", or addresses and ranges separated by commas ("loopback" when the
# proxy runs on the same machine). Leave it blank when nothing sits in front of
# the API.
TRUST_PROXY=
